          "db": "chicago_crime",
          "sql": "SELECT ward_no, COUNT(*) as total_crimes, SUM(CASE WHEN arrest = 'TRUE' THEN 1 ELSE 0 END) as arrests FROM Crime WHERE ward_no IS NOT NULL GROUP BY ward_no",
